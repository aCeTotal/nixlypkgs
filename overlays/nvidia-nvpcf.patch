+// RM must not touch a GPU in D3cold.
+static void nv_acpi_nvpcf_notify_awake(nvidia_stack_t *sp)
+{
+    nv_linux_state_t *nvl;
+    nv_state_t *nv;
+
+    LOCK_NV_LINUX_DEVICES();
+    for (nvl = nv_linux_devices; nvl != NULL; nvl = nvl->next)
+    {
+        nv = NV_STATE_PTR(nvl);
+        down(&nvl->ldata_lock);
+        if ((nv->flags & NV_FLAG_INITIALIZED) &&
+            (rm_ref_dynamic_power(sp, nv, NV_DYNAMIC_PM_FINE) == NV_OK))
+        {
+            rm_acpi_nvpcf_notify(sp);
+            rm_unref_dynamic_power(sp, nv, NV_DYNAMIC_PM_FINE);
+            up(&nvl->ldata_lock);
+            break;
+        }
+        up(&nvl->ldata_lock);
+    }
+    UNLOCK_NV_LINUX_DEVICES();
+}
