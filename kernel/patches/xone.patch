@@ -0,0 +1,12 @@
+# SPDX-License-Identifier: GPL-2.0-only
+config JOYSTICK_XONE
+	tristate "Xbox One and Series controllers (xone)"
+	depends on USB && INPUT && SND && CFG80211
+	select CRYPTO_RSA
+	select CRYPTO_ECDH
+	select CRYPTO_SHA256
+	select INPUT_FF_MEMLESS
+	select SND_PCM
+	help
+	  Drives the Xbox wireless dongle, wired controllers and headsets
+	  that speak the Gaming Input Protocol, in place of xpad.
