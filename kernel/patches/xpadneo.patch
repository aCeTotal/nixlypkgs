@@ -0,0 +1,9 @@
+# SPDX-License-Identifier: GPL-2.0-only
+config HID_XPADNEO
+	tristate "Xbox controllers over Bluetooth (xpadneo)"
+	depends on HID && INPUT && POWER_SUPPLY
+	select INPUT_FF_MEMLESS
+	help
+	  Xbox One, Series and Elite controllers over Bluetooth with
+	  rumble, trigger rumble, paddles and battery, in place of
+	  hid-microsoft for them.
