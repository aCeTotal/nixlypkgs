+// SPDX-License-Identifier: GPL-2.0
+#include <crypto/sha2.h>
+#include <crypto/utils.h>
+#include <linux/init.h>
+#include <linux/string.h>
+#include <linux/suspend.h>
+
+#include "power.h"
+
+/* Never written to the image. */
+static u8 hibernate_key[SHA256_DIGEST_SIZE] __nosavedata;
+static bool hibernate_key_set __nosavedata;
+
+/* Empty on disk; resume fills it. */
+static struct hibernate_key_slot hibernate_slot = { .magic = HIBERNATE_SLOT_MAGIC };
+
+void __init hibernate_auth_set_key(const u8 *key, u32 len)
+{
+	if (len != sizeof(hibernate_key))
+		return;
+	memcpy(hibernate_key, key, len);
+	hibernate_key_set = true;
+}
+
+bool hibernate_auth_available(void)
+{
+	return hibernate_key_set;
+}
+
+void hibernate_auth_init(struct hmac_sha256_ctx *ctx)
+{
+	struct hmac_sha256_key key;
+
+	hmac_sha256_preparekey(&key, hibernate_key, sizeof(hibernate_key));
+	hmac_sha256_init(ctx, &key);
+	memzero_explicit(&key, sizeof(key));
+}
+
+bool hibernate_auth_verify(struct hmac_sha256_ctx *ctx, const u8 *mac)
+{
+	u8 computed[SHA256_DIGEST_SIZE];
+	bool valid;
+
+	hmac_sha256_final(ctx, computed);
+	valid = !crypto_memneq(computed, mac, sizeof(computed));
+	memzero_explicit(computed, sizeof(computed));
+	return valid;
+}
+
+phys_addr_t hibernate_auth_slot(void)
+{
+	return __pa_symbol(&hibernate_slot);
+}
+
+void hibernate_auth_fill(struct hibernate_key_slot *slot)
+{
+	slot->magic = HIBERNATE_SLOT_MAGIC;
+	memcpy(slot->key, hibernate_key, sizeof(slot->key));
+	slot->filled = true;
+}
+
+/* KASLR moved the nosave copy. */
+void hibernate_auth_resumed(void)
+{
+	if (hibernate_slot.filled) {
+		memcpy(hibernate_key, hibernate_slot.key, sizeof(hibernate_key));
+		hibernate_key_set = true;
+	}
+	memzero_explicit(hibernate_slot.key, sizeof(hibernate_slot.key));
+	hibernate_slot.filled = false;
+}
