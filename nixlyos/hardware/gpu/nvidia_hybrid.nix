{ config, lib, pkgs, hwData, ... }:

# PRIME offload behind an Intel or AMD iGPU.

let
  # Decimal PCI addresses generated by scripts/detect-hw.sh.
  gpu = hwData.detected;
  blackwell = gpu.nvidiaArch == "blackwell_plus";
  # Mesa Vulkan ICDs of the iGPU.
  icds = { intel = [ "intel_icd" "intel_hasvk_icd" ]; amd = [ "radeon_icd" ]; }.${gpu.primary};
in
{
  imports = [ ./nvidia_ac_reload.nix ];

  services.xserver.videoDrivers = [ "nvidia" ];

  nixpkgs.overlays = [
    (final: prev: {
      # Blender and Gaea opt back into dGPU.
      Blender_bin_lts = final.symlinkJoin {
        inherit (prev.Blender_bin_lts) name meta;
        paths = [ prev.Blender_bin_lts ];
        nativeBuildInputs = [ final.makeWrapper ];
        postBuild = ''
          wrapProgram $out/bin/blender \
            --unset VK_DRIVER_FILES \
            --set __NV_PRIME_RENDER_OFFLOAD 1 \
            --set __NV_PRIME_RENDER_OFFLOAD_PROVIDER NVIDIA-G0 \
            --set __GLX_VENDOR_LIBRARY_NAME nvidia \
            --set __VK_LAYER_NV_optimus NVIDIA_only
        '';
      };
      gaea = final.symlinkJoin {
        inherit (prev.gaea) name meta;
        paths = [ prev.gaea ];
        nativeBuildInputs = [ final.makeWrapper ];
        postBuild = ''
          wrapProgram $out/bin/gaea \
            --unset VK_DRIVER_FILES \
            --set __VK_LAYER_NV_optimus NVIDIA_only
        '';
      };
    })
  ];

  hardware.graphics = {
    enable = true;
    enable32Bit = true;
    extraPackages = with pkgs; [
      vulkan-loader
      libGL
      libglvnd
    ];
    extraPackages32 = with pkgs.pkgsi686Linux; [
      vulkan-loader
      libGL
      libglvnd
    ];
  };

  hardware.nvidia = {
    modesetting.enable = true;
    # Persistenced keeps the dGPU initialized (awake) at all times — the main
    # idle drain. Off, so the driver can drop the GPU when nothing uses it.
    nvidiaPersistenced = false;
    # Save/restore dGPU state across S3 so a closed lid actually sleeps it.
    powerManagement.enable = true;
    # D3cold whenever no offload client runs.
    powerManagement.finegrained = true;
    # Blackwell runs only the open modules.
    open = blackwell;
    nvidiaSettings = false;
    package = lib.mkDefault config.boot.kernelPackages.nvidiaPackages.latest;

    # nvidia-powerd pins the GPU ceiling at its 10 W floor here, so the driver's
    # static 80 W default is better.
    dynamicBoost.enable = false;

    # GSP enforces the SBIOS power clamp; open modules require it.
    gsp.enable = blackwell;

    # Offload: reverseSync black-screened the iGPU panel.
    prime = {
      offload.enable = true;
      offload.enableOffloadCmd = true;
      intelBusId = lib.mkIf (gpu.primary == "intel") gpu.intel;
      amdgpuBusId = lib.mkIf (gpu.primary == "amd") gpu.amd;
      nvidiaBusId = gpu.nvidia;
    };
  };

  boot = {
    # Stage 2: the iGPU owns the boot console.
    kernelModules = [ "nvidia" "nvidia_uvm" "nvidia_modeset" "nvidia_drm" ];
    kernelParams = [
      "nvidia_drm.modeset=1"
      "nvidia_drm.fbdev=1"
      # Skip zeroing new GPU memory.
      "nvidia.NVreg_InitializeSystemMemoryAllocations=0"
      # No-op before Ampere vbios.
      "nvidia.NVreg_EnableResizableBar=1"
    ];
  };

  environment.systemPackages = with pkgs; [
    vulkan-tools
    libva-utils
    nvtopPackages.full
    egl-wayland
    nvidia-vaapi-driver
  ];

  # No global NVIDIA GBM/GLX vendor: black-screens the iGPU panel.

  environment.sessionVariables = {
    # Vulkan probes wake the dGPU.
    VK_DRIVER_FILES = lib.concatStringsSep ":" (
      map (n: "/run/opengl-driver/share/vulkan/icd.d/${n}.x86_64.json") icds
      ++ map (n: "/run/opengl-driver-32/share/vulkan/icd.d/${n}.i686.json") icds
    );
    # NVIDIA EGL probes wake the dGPU.
    __EGL_VENDOR_LIBRARY_FILENAMES =
      "/run/opengl-driver/share/glvnd/egl_vendor.d/50_mesa.json:"
      + "/run/opengl-driver-32/share/glvnd/egl_vendor.d/50_mesa.json";
    __GL_VRR_ALLOWED = "1";
    __GL_GSYNC_ALLOWED = "1";
    __GL_THREADED_OPTIMIZATIONS = "1";
    __GL_SHADER_DISK_CACHE = "1";
    __GL_SHADER_DISK_CACHE_SIZE = "10737418240";   # 10 GiB shader cache
    # Never trim the cache mid-session; eviction shows up as recompile hitches.
    __GL_SHADER_DISK_CACHE_SKIP_CLEANUP = "1";
    MESA_SHADER_CACHE_MAX_SIZE = "10G";
    # Wrapper sets NIXLY_RENDERER itself.
    ELECTRON_OZONE_PLATFORM_HINT = "auto";
  };
}
